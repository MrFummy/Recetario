{"nodes": [{"id": "readme_mi_recetario", "label": "Mi Recetario", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web app for organizing recipes; ingestion is delegated to an automated n8n flow rather than an app-owned backend."}, {"id": "readme_react_vite_frontend", "label": "React + TypeScript + Vite frontend", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tailwind_css", "label": "Tailwind CSS v4 styling", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_supabase_database", "label": "Supabase database (direct JS client)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "README specifies the JS client is used directly ('cliente JS directo') \u2014 no server-side data access layer is described between the SPA and the database."}, {"id": "readme_n8n_webhook", "label": "n8n webhook recipe ingestion", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automation (ingestion, deletion, email sharing) is pushed to n8n webhooks so the static SPA never needs its own server process. The app derives the three routes /nueva-receta, /eliminar-receta and /compartir-receta from a single configured base URL."}, {"id": "readme_catalogo_module", "label": "Catalogo module (masonry recipe viewer)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Masonry layout plus an ingredient-based search is chosen as the read surface over recipes stored in Supabase."}, {"id": "readme_anadir_receta_module", "label": "Anadir Receta module (PDF upload form)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept deliberately simple: the form only ships a recipe PDF to the n8n flow, so all parsing and persistence logic lives outside the frontend."}, {"id": "readme_env_configuration", "label": "Environment configuration (.env variables)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY and VITE_N8N_WEBHOOK_BASE are externalized to .env (copied from .env.example) so deployment targets differ only by configuration, not code."}, {"id": "readme_npm_run_build", "label": "npm run build (production bundle)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Produces a /dist folder whose contents are copied to the Nginx web root; the build is the entire deployment artifact."}, {"id": "readme_nginx_spa_fallback", "label": "Nginx SPA fallback configuration", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "try_files $uri $uri/ /index.html is required because client-side routing means non-root URLs have no corresponding file on disk."}, {"id": "readme_static_spa_deployment", "label": "Static SPA deployment on home Nginx server", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app is designed as a purely static SPA so it can be served from a domestic Nginx instance with no application runtime, which is what forces both data access and automation out to external services."}], "edges": [{"source": "readme_mi_recetario", "target": "readme_catalogo_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_mi_recetario", "target": "readme_anadir_receta_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_mi_recetario", "target": "readme_react_vite_frontend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_mi_recetario", "target": "readme_tailwind_css", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_mi_recetario", "target": "readme_supabase_database", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_mi_recetario", "target": "readme_n8n_webhook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_catalogo_module", "target": "readme_supabase_database", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_anadir_receta_module", "target": "readme_n8n_webhook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_env_configuration", "target": "readme_supabase_database", "relat